# myplex-swarm environment variables
# Copy to .env and fill in the values

# Timezone
TZ=America/Chicago

# Plex advertise IP (your Plex URL)
IP=myplex.echoinggreen.net

# Container name (must match the existing named volume prefix)
CNAME=myplex_swarm

# Config base path (Docker named volumes directory)
CONFIGLOC=/var/lib/docker/volumes/

# UID/GID for the Plex process (1000:ladmin)
PUID=1000
PGID=1000

# NOTE: PLEX_CLAIM is not required — the server is already claimed.
# If you need to re-claim (e.g. after a full reset), get a new token from:
#   https://www.plex.tv/claim/
# and add: PLEX_CLAIM=<token>
